{
  "name": "royal-wedding-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-oriented, mobile-first multi-wedding photo sharing platform with royal Indian aesthetics",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "seed": "npm run seed --workspace=apps/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "keywords": [
    "wedding",
    "photo-sharing",
    "mobile-first",
    "realtime",
    "socketio"
  ],
  "author": "Royal Wedding Team",
  "license": "MIT"
}
